# Repo-root .dockerignore — read by `docker build` for the compose context.
# (deploy/docker/.dockerignore is documentation; this file is the one
# Docker actually reads.)

# Build artifacts the Dockerfile rebuilds
node_modules
dist
frontend
coverage
test-results.junit.xml
playwright-report
.vitest-cache

# Runtime / local state — must not bake into images.
# Every pattern is `**/`-prefixed: Docker matches .dockerignore from the
# context root and `*` never crosses `/`, so the old root-only `*.sqlite`
# let server/database.sqlite (+ its -wal/-shm, a dozen .bak.* backups and
# server/rohy.db) into any image built from a working checkout — password
# hashes, PII, provider keys (security audit 2026-10-26, F-27). Pinned by
# tests/server/sec2-e2-dockerignore.test.js.
**/*.log
**/*.sqlite
**/*.sqlite-*
**/*.sqlite.bak.*
**/*.sqlite.backup-*
**/*.db
**/*.db-*
# Runtime uploads are a deployment's own data (the upload mount), never
# part of an image; `vite build` would otherwise also copy them into
# frontend/ (L6-12).
public/uploads
# Every .env, not only the root one: a bare `.env` matches the build-context
# root alone, so server/.env (JWT_SECRET, local paths) was copied into the
# image. Configuration reaches a container through compose's environment.
**/.env
**/.env.*
# …except the server's documented template, which holds no secret (the
# compose template deploy/docker/.env.example stays out: see the end of file).
!server/.env.example

# Server-local state directories
server/data/piper/venv
server/data/piper/voices
server/data/uploads

# OS + editor noise
.DS_Store
.idea
.vscode
.cursor

# Source control + CI metadata not needed at build time
.git
.gitignore
.github

# Docs that bloat the context — Dockerfile only needs source
docs
*.md
LEARNINGS.md
HANDOFF.md
CHANGES.md
README.md
deploy/README.md
deploy/docker/README.md
deploy/PORTABILITY.md
# CHANGELOG.md is NOT docs bloat — the runtime reads it for the in-app
# "What's new" surface (GET /api/help/release-notes). The blanket *.md above
# would strip it from the build context, so re-include it explicitly. Keep
# this AFTER every *.md exclusion so nothing re-ignores it.
!CHANGELOG.md
# NOTICE.md is a legal artifact, not documentation. The Carm Research License
# requires third-party notices to travel with every copy, so an image that
# carried LICENSE (no extension, never excluded) but dropped its notice would
# ship in breach. Same rule as CHANGELOG.md: keep this AFTER every *.md
# exclusion. `licenses/` is a directory and survives the blanket rule.
!NOTICE.md

# Tests don't ship to runtime images
tests
bench
playwright.config.js
vitest.config.js
e2e

# Agent + scratch directories
codexIntmep
**/AGENT-NOTE-*.md
# Security audit material (exploit roadmaps) and the e2e auth tokens.
audit
sec*.md
tests/e2e/.auth
# Named explicitly as well: these hold live credentials (the Prova tokens, a
# Google service key), so they must stay out even if the patterns above are
# ever narrowed. `*.md` and `AGENT-NOTE-*.md` already cover the first today.
AGENT-NOTE-PROVA-*.md
googlekey.text
ultraReview
.claude
.claude-claudef
# Root scratch (gitignored, but a local `docker build` sees the working
# directory rather than a clean clone — keep it out of the build context).
reports
todo
docx
site
.local-backups
rohy-airgap-source-*.tar.gz*
*.png
case-author-harness.html
pathology-harness.html

# Container-build-only files that we DON'T want to copy into the image
# beyond the Dockerfile itself (the Dockerfile is read separately)
deploy/docker/Caddyfile
deploy/docker/compose.yml
deploy/docker/.env
deploy/docker/.env.example
