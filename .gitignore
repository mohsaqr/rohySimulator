/OyonR/standalone/vendor/dynajs/README.md
/OyonR/standalone/vendor/dynajs/LEARNINGS.md

# i18n change-detection sidecar: a per-key sha256 manifest of the English
# source strings, consumed by scripts/translate-locales.mjs (delta
# re-translation) and `npm run i18n:check`. It is derived data, regenerated
# from src/locales/en/*.json — not source. Kept untracked because its
# "key": "<hex>" shape trips secret scanners (the hexes are hashes of UI
# labels like "Password"/"API key", never credentials).
/src/locales/.en-hashes.json
# XLIFF review exports (npm run i18n:xliff:export) are transient hand-offs to
# translators; the committed truth is src/locales/<lang>/*.json plus the
# per-string review status in src/locales/.status/<lang>.json (tracked).
/i18n/xliff/
googlekey.text

# The knowledge base is a DERIVED artifact — rebuild with `npm run kb:build`.
# Carm committed its equivalent and it now accounts for 6.24 GB of that repo's
# history (see its AGENT-NOTE-git-bloat.md). This one stays out of git.
data/knowledge.db
data/knowledge.db-wal
data/knowledge.db-shm

# ---------------------------------------------------------------------------
# Root scratch. These live on disk and are deliberately NOT tracked — the
# repo root is the first thing a contributor reads, and a root full of
# one-off notes, screenshots and build output makes it unreadable.
# Durable documentation belongs in docs/; design notes in docs/design/.
# ---------------------------------------------------------------------------

# Per-session agent artifacts (CLAUDE.md forbids committing these).
/CLAUDE.md
/AGENT-NOTE-*.md
/ROHY_TECHNICAL_REPORT.md
/rohydev-snap.md
/release-notes.md
/lesson.md
/login2.md

# Working directories: triage reports, task notes, .docx exports of the same.
/reports/
/todo/
/docx/

# Built VitePress output (the sources under docs/ are what is tracked) and
# local database/asset backups taken by the migration runner and by hand.
/site/
/.local-backups/

# Air-gap source bundles — regenerated by the release tooling, ~100 MB each.
/rohy-airgap-source-*.tar.gz
/rohy-airgap-source-*.tar.gz.sha256

# Ad-hoc screenshots dropped at the root while debugging. Screenshots that
# belong to the documentation live in docs/images/.
/*.png

# Standalone dev harnesses for plugin authoring — useful locally, not part of
# the app build (nothing in vite.config.js or package.json references them).
/case-author-harness.html
/pathology-harness.html
/src/case-author-harness.jsx
/src/pathology-harness.jsx

# Pathology plugin content, symlinked into the dev tree from a sibling
# checkout (Pathoyon). These are ABSOLUTE-PATH symlinks — committing them
# would point every other clone at a directory that does not exist there.
# A dangling one also breaks `vite build`, which copies public/ verbatim.
/public/gross
/public/slides

# Rendered copies of the plugin standard. docs/design/plugin-standard.md is
# the source; the HTML is a local export for reading offline.
/docs/design/plugin-standard.html
/docs/design/plugin-standard-1.3-draft.html

# Starter content bundles — ~210 MB of imaging, generated from the sibling
# content origins by `npm run starter-content`. Committed, they would sit in
# git history forever and every clone would pay for them. They must instead be
# built into the artefacts that ship (the Docker image, the air-gap tarball) on
# a machine that has the archives.
server/plugin-content/

# Content release archives and the download cache. `npm run pack:content`
# produces the first from server/plugin-content/; `npm run setup:content`
# fills the second on its way to producing it. Neither belongs in git — they
# are hundreds of megabytes and are published as release assets.
dist-content-release/
.content-cache/
