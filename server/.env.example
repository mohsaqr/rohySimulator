# JWT Secret Key - Generate a random string for production
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-secret-key-here

# JWT Token Expiry (default: 24 hours)
JWT_EXPIRY=24h

# Server Port
PORT=3000

# ── Kokoro TTS memory (optional) ─────────────────────────────────────────
# Where @huggingface/transformers caches the ~330 MB Kokoro model. Set it
# OUTSIDE the repo in production so `npm ci` does not wipe it (a wiped cache
# means a ~15 s re-download on the next voice reply instead of ~2 s).
# TRANSFORMERS_CACHE=/opt/data/rohy/transformers-cache

# Minutes without a synthesis before the Kokoro model is unloaded from RAM
# (frees ~380 MB on Linux). The next voice reply reloads it transparently.
# 0 = keep it resident for the life of the process and warm it at boot.
# ROHY_KOKORO_IDLE_UNLOAD_MIN=10

# ── Plugin remote content (RPS-1 'remote' capability, optional) ───────────
# Where each plugin's bulk content is fetched from, as a comma-separated
# <pluginId>=<origin> list. Whole-slide pyramids are gigabytes and have no
# business in rohy's image, its backups or its air-gap bundle, so a case
# addresses a slide as `remote:tiles/case42/slide1.dzi` and rohy relays it
# from the host named here.
#
# This is the ONLY place a host may be chosen. A manifest may not name one and
# a case config may not name one — a case author picks a path, an operator
# picks a host. Unset means no plugin has a remote origin and every plugin
# proxy route answers 503. A malformed entry stops the server from booting.
# The origin must serve `/content.json` at its root (every plugin content
# bundle does — see the plugin's content-bundle script); /api/health/plugins
# probes it and the deploy verify fails if it is dark.
# ROHY_PLUGIN_ORIGINS=pathology=https://slides.example.edu
