# JWT Secret Key - Generate a random string for production
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-secret-key-here

# JWT Token Expiry (default: 24 hours)
JWT_EXPIRY=24h

# Server Port
PORT=3000

# ── Reverse proxy ────────────────────────────────────────────────────────
# Express "trust proxy" setting (default: loopback). Rate limits, the audit
# log and login_logs key on the client IP; when the reverse proxy runs on
# another host or in its own container, rohy sees the proxy's address for
# everyone — every client shares one login rate-limit bucket and the audit
# log names the proxy. Set this to the proxy's IP or CIDR (or a hop count)
# so X-Forwarded-For is honoured from THAT proxy only; never "true" on a
# server reachable without a proxy, because then any client can spoof its IP.
# Production boots with a warning while this is unset or "loopback".
# ROHY_TRUST_PROXY=172.18.0.0/16

# ── Outbound LLM endpoints ───────────────────────────────────────────────
# Every URL a person can type for the server to call (a custom OpenAI-
# compatible endpoint, a per-session baseUrl, the admin "detect models" probe)
# is checked in server/lib/outboundUrl.js: http(s) only, no credentials, and
# no loopback, link-local, private or unspecified host — so an administrator
# cannot turn rohy into a probe of its own network (cloud metadata lives at
# 169.254.169.254). Set this to 1 ONLY when the model server really is on the
# LAN (Ollama or vLLM on an on-premises box); the scheme and credential rules
# still apply. Off by default.
# ROHY_ALLOW_PRIVATE_LLM_HOSTS=1

# ── Kokoro TTS memory (optional) ─────────────────────────────────────────
# Where @huggingface/transformers caches the ~330 MB Kokoro model. Set it
# OUTSIDE the repo in production so `npm ci` does not wipe it (a wiped cache
# means a ~15 s re-download on the next voice reply instead of ~2 s).
# TRANSFORMERS_CACHE=/opt/data/rohy/transformers-cache

# Minutes without a synthesis before the Kokoro model is unloaded from RAM
# (frees ~380 MB on Linux). The next voice reply reloads it transparently.
# 0 = keep it resident for the life of the process and warm it at boot.
# ROHY_KOKORO_IDLE_UNLOAD_MIN=10

# ── Remote Kokoro TTS (optional) ─────────────────────────────────────────
# Synthesize Kokoro voices on an OpenAI-compatible host instead of this
# box's CPU (POST <url>/audio/speech, response_format pcm). Same voices,
# ~0.2 s per sentence instead of ~1.3 s, and no model held in RAM. The local
# model stays as the fallback: a failed remote request speaks locally, and
# after 3 failures in a row the remote host is skipped for 60 s. Unset URL =
# local synthesis only (the default). Never commit the key.
# The same URL + key can instead be set by an admin in Settings → Voice (the
# Kokoro card), which overrides these; the key below is only ever sent to the
# URL below, never to a URL entered there.
# ROHY_KOKORO_URL=https://api.dynasite.org/v1
# ROHY_KOKORO_API_KEY=
# Per-request timeout in ms (default 8000).
# ROHY_KOKORO_TIMEOUT_MS=8000

# ── Plugin remote content (RPS-1 'remote' capability, optional) ───────────
# Where each plugin's bulk content is fetched from, as a comma-separated
# <pluginId>=<origin> list. Whole-slide pyramids are gigabytes and have no
# business in rohy's image, its backups or its air-gap bundle, so a case
# addresses a slide as `remote:tiles/case42/slide1.dzi` and rohy relays it
# from the host named here.
#
# This is the ONLY place a host may be chosen. A manifest may not name one and
# a case config may not name one — a case author picks a path, an operator
# picks a host. Unset means no plugin has a remote origin and every plugin
# proxy route answers 503. A malformed entry stops the server from booting.
# The origin must serve `/content.json` at its root (every plugin content
# bundle does — see the plugin's content-bundle script); /api/health/plugins
# probes it and the deploy verify fails if it is dark.
# ROHY_PLUGIN_ORIGINS=pathology=https://slides.example.edu
