n-timeline-slots.test.js && node tests/app-filter-windows.test.js && node tests/app-tna-pooling.test.js && node tests/app-embed-contracts.test.js && node tests/app-pill-a11y.test.js && node tests/app-analyze-typing.test.js && node tests/app-typing-charts.test.js && node tests/app-voice-charts.test.js && node tests/app-analyze-voice.test.js && node tests/ai-assist.test.js && node tests/interaction-tracker.test.js && node tests/interaction-aggregator.test.js && node tests/text-analyzer.test.js && node tests/discourse-aggregator.test.js && node tests/voice-features.test.js && node tests/pitch.test.js && node tests/voice-turn-controller.test.js && node tests/vad-adapter.test.js && node tests/voice-aggregator.test.js && node tests/voice-worker.test.js && node tests/license-contract.test.js && node tests/exports-map.test.js",
